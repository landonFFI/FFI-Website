# Copy these into Vercel → Project → Settings → Environment Variables.
# Use test-mode values for Preview and live values for Production.
# Never commit real keys.

# Restricted key (rk_...) with: Checkout Sessions write, Prices read,
# Products read. Add Customers / Invoices / Invoice Items write for the invoice script.
STRIPE_SECRET_KEY=rk_test_...

# From Dashboard → Developers → Webhooks → your endpoint → Signing secret.
STRIPE_WEBHOOK_SECRET=whsec_...

# Leave false until you have an active registration in Dashboard → Tax → Registrations.
STRIPE_TAX_ENABLED=false

SITE_URL=https://fordfrontierinvestments.com

# Make.com scenario webhook that receives paid orders, renewals, and failures.
FULFILLMENT_WEBHOOK_URL=https://hook.us2.make.com/...

# Dashboard → Settings → Billing → Customer portal → "Login link".
STRIPE_PORTAL_LOGIN_URL=https://billing.stripe.com/p/login/...
