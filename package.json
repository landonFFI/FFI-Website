{
  "name": "ffi-website",
  "private": true,
  "type": "module",
  "description": "Ford Frontier Investments website: static pages plus Vercel serverless functions for Stripe.",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "node scripts/build-store.mjs",
    "stripe:setup-catalog": "node scripts/setup-catalog.mjs",
    "stripe:send-invoice": "node scripts/send-invoice.mjs",
    "test": "node --test tests/*.test.js",
    "sitemap": "node scripts/build-sitemap.mjs",
    "sitemap:check": "node scripts/build-sitemap.mjs --check"
  },
  "dependencies": {
    "stripe": "^22.6.2"
  }
}
