<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ p.title_tag }}</title>
  <meta name="description" content="{{ p.meta_description }}" />
  <meta name="keywords" content="{{ p.keywords_csv }}" />
  <meta name="author" content="Landon Ford, Ford Frontier Investments" />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <link rel="canonical" href="{{ p.canonical }}" />

  <meta property="og:type" content="article" />
  <meta property="og:site_name" content="Ford Frontier Investments" />
  <meta property="og:url" content="{{ p.canonical }}" />
  <meta property="og:title" content="{{ p.h1 }}" />
  <meta property="og:description" content="{{ p.meta_description }}" />
  <meta property="article:published_time" content="{{ p.date_published }}" />
  <meta property="article:modified_time" content="{{ p.date_modified }}" />
  <meta property="article:author" content="Landon Ford" />
  <meta property="article:section" content="{{ p.cluster_name }}" />

  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="{{ p.h1 }}" />
  <meta name="twitter:description" content="{{ p.meta_description }}" />

  <script type="application/ld+json">
{{ p.schema_article }}
  </script>
  <script type="application/ld+json">
{{ p.schema_breadcrumb }}
  </script>
  <script type="application/ld+json">
{{ p.schema_faq }}
  </script>

  <link rel="stylesheet" href="../../assets/css/main.css" />
  <link rel="stylesheet" href="../../assets/css/mobile-fix.css" />
</head>
<body>
<div id="site-nav"></div>

<!-- POST HERO -->
<header class="blog-hero">
  <div class="container"><div class="blog-hero__inner">
    <nav class="blog-hero__crumbs" aria-label="Breadcrumb"><a href="../../index.html">Home</a> / <a href="../blog.html">Blog</a> / {{ p.cluster_name }}</nav>
    <a class="blog-hero__topic" href="../blog.html#{{ p.cluster }}">{{ p.cluster_name }}</a>
    <h1>{{ p.h1 }}</h1>
    <p class="blog-hero__dek">{{ p.dek }}</p>
    <p class="blog-hero__byline">By <strong>Landon Ford</strong>, owner of Ford Frontier Investments, Birmingham, Alabama.<br />Updated <time datetime="{{ p.date_modified }}">{{ p.date_modified_human }}</time>. About a {{ p.read_minutes }}-minute read.</p>
  </div></div>
</header>

<div class="container">
  <div class="blog-layout">
    <article class="blog-article" aria-labelledby="post-title">
      <span id="post-title" hidden>{{ p.h1 }}</span>

      <!-- SHORT ANSWER (answer-first for search and AI tools) -->
      <section class="blog-answer" aria-label="The short answer">
        <p class="blog-answer__label">The short answer</p>
        <p class="blog-answer__text">{{ p.short_answer }}</p>
      </section>

      <!-- MOBILE TABLE OF CONTENTS -->
      <details class="blog-toc blog-toc--mobile">
        <summary>In this article</summary>
        <ol>
{% for item in p.toc %}          <li><a href="#{{ item.id }}">{{ item.text }}</a></li>
{% endfor %}          <li><a href="#faq">Common questions</a></li>
        </ol>
      </details>

      <!-- ARTICLE BODY (copy is locked; do not edit wording) -->
      <div class="blog-body">
{{ p.body_html }}
      </div>

      <!-- AUTHOR -->
      <aside class="blog-author" aria-label="About the author">
        <div class="blog-author__mark" aria-hidden="true">LF</div>
        <div>
          <p class="blog-author__name">About Landon Ford</p>
          <p>Landon Ford owns Ford Frontier Investments, an Alabama-owned and operated ATM company based in Birmingham. He places, services, buys, and sells ATMs for businesses around Birmingham, Montgomery, and Tuscaloosa. Have a question this article didn't answer? Call or text him at <a href="tel:+12052108121">(205) 210-8121</a>. <a href="../about.html">More about us</a>.</p>
        </div>
      </aside>

      <!-- FAQ (uses the site's .faq-item accordion; main.js must load before </body>) -->
      <section class="blog-faq" id="faq">
        <h2>Common questions</h2>
{% for f in p.faq %}        <div class="faq-item">
          <button class="faq-item__q">{{ f.q }}</button>
          <div class="faq-item__a">
            <p>{{ f.a }}</p>
          </div>
        </div>
{% endfor %}      </section>

      <!-- SOURCES -->
      <section class="blog-sources" aria-labelledby="sources-title">
        <h2 id="sources-title">Sources</h2>
        <ol>
{% for s in p.sources %}          <li>{{ s.publisher }}, "<a href="{{ s.url }}" target="_blank" rel="noopener">{{ s.title }}</a>," {{ s.date }}.</li>
{% endfor %}        </ol>
      </section>

      <!-- RELATED -->
      <section class="blog-related" aria-labelledby="related-title">
        <h2 id="related-title">Keep reading</h2>
        <ul>
{% for r in p.related_posts %}          <li><a href="{{ r.slug }}.html">{{ r.h1 }}</a><span>{{ r.meta_description }}</span></li>
{% endfor %}        </ul>
      </section>
    </article>

    <!-- DESKTOP SIDEBAR -->
    <aside class="blog-sidebar" aria-label="Article navigation">
      <div class="blog-sidebar__sticky">
        <nav class="blog-toc" aria-label="In this article">
          <p class="blog-toc__title">In this article</p>
          <ol>
{% for item in p.toc %}            <li><a href="#{{ item.id }}">{{ item.text }}</a></li>
{% endfor %}            <li><a href="#faq">Common questions</a></li>
          </ol>
        </nav>
        <div class="blog-callcard">
          <p class="blog-callcard__title">Talk to Landon directly</p>
          <p>Straight answers about your business. No call center, no pressure.</p>
          <a class="blog-callcard__phone" href="tel:+12052108121">(205) 210-8121</a>
          <a class="btn btn--primary" href="#contact">{{ p.cta.button }}</a>
        </div>
      </div>
    </aside>
  </div>
</div>

<!-- FINAL CTA + FORM -->
<section class="section section--dark" id="contact">
  <div class="container">
    <div class="two-col reveal">
      <div>
        <span class="label" style="color:var(--gold);">Talk to Landon</span>
        <h2 style="font-family:var(--font-display);font-weight:900;font-size:clamp(24px,4vw,38px);color:var(--white);margin:12px 0 20px;">{{ p.cta.headline }}</h2>
        <p style="font-size:16px;color:rgba(255,255,255,0.7);margin-bottom:24px;">{{ p.cta.body }}</p>
        <p style="font-size:16px;color:rgba(255,255,255,0.7);margin-bottom:24px;">Alabama-owned and operated. Serving Birmingham, Montgomery, and Tuscaloosa. 98% uptime.</p>
        <div style="padding:24px;background:rgba(201,168,76,0.08);border:1px solid rgba(201,168,76,0.2);">
          <div style="font-family:var(--font-display);font-weight:700;font-size:16px;color:var(--white);margin-bottom:6px;">Call or text Landon directly</div>
          <a href="tel:+12052108121" style="font-family:var(--font-display);font-size:24px;font-weight:900;color:var(--gold);letter-spacing:0.02em;">(205) 210-8121</a>
          <div style="font-size:13px;color:rgba(255,255,255,0.5);margin-top:6px;">Or email: <a href="mailto:Landon@FordFrontierInvestments.com" style="color:rgba(255,255,255,0.6);">Landon@FordFrontierInvestments.com</a></div>
        </div>
      </div>
      <div>
        <form id="contact-form" style="display:flex;flex-direction:column;gap:16px;">
          <input type="hidden" name="access_key" value="{{ web3forms_key }}" />
          <input type="hidden" name="subject" value="{{ p.cta.form_subject }}" />
          <input type="hidden" name="from_name" value="Ford Frontier Investments Website" />
          <input type="hidden" name="source_page" value="{{ p.canonical }}" />
          <input type="hidden" name="redirect" value="false" />
          <div class="form-group">
            <label class="form-label" for="f-name">First name</label>
            <input type="text" class="form-input" id="f-name" name="first_name" required autocomplete="given-name" />
          </div>
          <div class="form-group">
            <label class="form-label" for="f-business">Business name</label>
            <input type="text" class="form-input" id="f-business" name="business" required autocomplete="organization" />
          </div>
          <div class="form-group">
            <label class="form-label" for="f-phone">Phone number</label>
            <input type="tel" class="form-input" id="f-phone" name="phone" required autocomplete="tel" placeholder="(205) 000-0000" />
          </div>
          <div class="form-group">
            <label class="form-label" for="f-question">Your question (optional)</label>
            <textarea class="form-input" id="f-question" name="message" rows="3"></textarea>
          </div>
          <button type="submit" class="btn btn--primary" style="width:100%;justify-content:center;padding:18px;font-size:16px;">{{ p.cta.button }}</button>
          <p style="font-size:12px;color:rgba(255,255,255,0.45);text-align:center;line-height:1.6;">We'll get back to you fast. No spam. No pressure.</p>
        </form>
      </div>
    </div>
  </div>
</section>

<div id="site-footer"></div>
<script src="../../assets/js/layout.js"></script>
<script src="../../assets/js/main.js"></script>
</body>
</html>

